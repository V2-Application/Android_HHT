<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.v2retail.dotvik.ho.HoMenu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="2dp"
        android:background="#000"
        android:padding="5dp">

        <Button
            android:id="@+id/ho_v11_to_msa_putway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="#e71821"
            android:text="V11 TO MSA PUTWAY"
            android:textColor="#fff" />

        <Button
            android:id="@+id/ho_picking_msa_to_smpl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="#e71821"
            android:text="Picking From MSA To (Smpl)"
            android:textColor="#fff" />
    </LinearLayout>
</FrameLayout>
